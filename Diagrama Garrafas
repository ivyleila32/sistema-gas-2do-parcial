        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam linetype ortho\n\n&#39; ===================================================\n&#39; JERARQUÍA PERSONA\n&#39; ===================================================\nabstract class Persona {\n  # id : int\n  # nombre : string\n  # telefono : string\n  __\n  + Persona(id: int, nom: string, tel: string)\n  + {abstract} ~Persona()\n  + getId() : int\n  + getNombre() : string\n  + getTelefono() : string\n  + {abstract} mostrarInfo() : void\n}\n\nclass Cliente {\n  - direccionEntrega : string\n  __\n  + Cliente(id: int, nom: string, tel: string, dir: string)\n  + ~Cliente()\n  + getDireccion() : string\n  + mostrarInfo() : void\n}\n\nclass Empleado {\n  - legajo : int\n  - cargo : string\n  __\n  + Empleado(id: int, nom: string, tel: string, leg: int, cargo: string)\n  + ~Empleado()\n  + getLegajo() : int\n  + getCargo() : string\n  + mostrarInfo() : void\n}\n\nPersona &lt;|-- Cliente : Herencia\nPersona &lt;|-- Empleado : Herencia\n\n&#39; ===================================================\n&#39; JERARQUÍA ARTÍCULO\n&#39; ===================================================\nclass Articulo {\n  # id : int\n  # nombre : string\n  # precioUnitario : double\n  __\n  + Articulo(id: int, nom: string, prec: double)\n  + virtual ~Articulo()\n  + getId() : int\n  + getNombre() : string\n  + virtual getPrecio() : double\n  + virtual mostrarDetalle() : void\n}\n\nclass Garrafa {\n  - capacidadKg : double\n  __\n  + Garrafa(id: int, nom: string, prec: double, cap: double)\n  + ~Garrafa()\n  + getCapacidadKg() : double\n  + mostrarDetalle() : void\n}\n\nclass Accesorio {\n  - tipo : string\n  __\n  + Accesorio(id: int, nom: string, prec: double, tipo: string)\n  + ~Accesorio()\n  + getTipo() : string\n  + mostrarDetalle() : void\n}\n\nArticulo &lt;|-- Garrafa : Herencia\nArticulo &lt;|-- Accesorio : Herencia\n\n&#39; ===================================================\n&#39; DETALLE Y PEDIDO\n&#39; ===================================================\nclass DetallePedido {\n  - articulo : Articulo*\n  - cantidad : int\n  __\n  + DetallePedido(art: Articulo*, cant: int)\n  + ~DetallePedido()\n  + calcularSubtotal() : double\n  + mostrarLinea() : void\n  + getArticulo() : Articulo*\n  + getCantidad() : int\n}\n\nclass Pedido {\n  - idPedido : int\n  - cliente : Cliente*\n  - empleado : Empleado*\n  - detalles : DetallePedido**\n  - cantItems : int\n  - capItems : int\n  __\n  + Pedido(idPed: int, cli: Cliente*, emp: Empleado*, cap: int)\n  + ~Pedido()\n  + agregarArticulo(art: Articulo*, cantidad: int) : bool\n  + calcularTotal() : double\n  + mostrarPedido() : void\n  + getIdPedido() : int\n}\n\n&#39; Relaciones de Asociación / Agregación / Composición\nPedido o-- \&quot;1\&quot; Cliente : Agregación\nPedido o-- \&quot;1\&quot; Empleado : Agregación\nPedido *-- \&quot;1..*\&quot; DetallePedido : Composición\nDetallePedido o-- \&quot;1\&quot; Articulo : Agregación\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hZewinOqjL_tc1vt2ZRw-1">
